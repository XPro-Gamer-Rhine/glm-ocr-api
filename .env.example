# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Ollama / GLM-OCR
OLLAMA_HOST=http://127.0.0.1:11434
GLM_OCR_MODEL=glm-ocr:latest

# Bootstrap behaviour (set false to skip auto install / model pull on boot)
AUTO_INSTALL=true
AUTO_PULL_MODEL=true
AUTO_START_OLLAMA=true

# Extraction pipeline
MAX_FILE_SIZE_MB=500
# 1 = process one page at a time (recommended: best accuracy + flat memory)
OCR_CONCURRENCY=1
RENDER_DPI=200
# Pages whose amount columns come back empty get re-OCR'd at this DPI
RETRY_DPI=150
OCR_TIMEOUT_MS=180000
# Use GLM-OCR information-extraction mode on page 1 to refine metadata
LLM_METADATA=true

# Storage root (uploads + extraction results live here)
DATA_DIR=storage
