# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Ollama / GLM-OCR
OLLAMA_HOST=http://127.0.0.1:11434
GLM_OCR_MODEL=glm-ocr:latest

# Bootstrap behaviour (set false to skip auto install / model pull on boot)
AUTO_INSTALL=true
AUTO_PULL_MODEL=true
AUTO_START_OLLAMA=true

# Extraction pipeline
MAX_FILE_SIZE_MB=500
# 1 = process one page at a time (recommended: best accuracy + flat memory)
OCR_CONCURRENCY=1
RENDER_DPI=200
# Pages whose amount columns come back empty get re-OCR'd at this DPI
RETRY_DPI=150
OCR_TIMEOUT_MS=180000
# Use GLM-OCR information-extraction mode on page 1 to refine metadata
LLM_METADATA=true

# Storage root (uploads + extraction results live here)
DATA_DIR=storage

# ═══ Agent mode ═════════════════════════════════════════════════════════════
# Everything below is for `npm run agent:worker` — the outbound worker that
# claims documents from the Dime product's job boards. The local HTTP API above
# runs without any of it.

# ── Backends ────────────────────────────────────────────────────────────────
# The company's backend list is NOT duplicated here. It is read from the helper
# agent's .env, which already carries DIME_ENVIRONMENTS and the suffixed
# DIME_API_BASE_URL_QA / _PROD / _LOCAL keys beside it — one file, both agents.
# Point this elsewhere to move it, or set it empty to run standalone from the
# plain keys below.
DIME_SHARED_ENV_FILE=../dime-helper-agent/.env
# Standalone fallbacks, used only when the shared file is absent:
DIME_ENVIRONMENTS=
DIME_API_BASE_URL=http://localhost:5000

# Machine token for the product's /api/v1/internal/ocr-agent routes. Must equal
# OCR_AGENT_TOKEN on that API. A DIFFERENT secret from the helper agent's
# BRIDGE_TOKEN on purpose — this one opens raw statement downloads.
# Per-backend: OCR_BRIDGE_TOKEN_QA, OCR_BRIDGE_TOKEN_PROD, …
OCR_BRIDGE_TOKEN=

# ── Worker ──────────────────────────────────────────────────────────────────
# Which boards this worker claims from.
OCR_AGENT_KINDS=statement
# Defaults to the hostname; set only when running two workers on one machine.
OCR_WORKER_ID=
JOB_POLL_INTERVAL_MS=3000
# Files read at once, across every backend. One: OCR saturates the GPU and
# three models voting saturates what is left.
OCR_MAX_CONCURRENT_JOBS=1
# A whole extraction's wall clock (3 hours). A 300-page scan is legitimately long.
OCR_JOB_TIMEOUT_MS=10800000
# Keep each job's downloaded file after it finishes (debugging).
OCR_KEEP_FILES=false

# ── The three readers ───────────────────────────────────────────────────────
# They exist to disagree, so they must be independent. Pointing two of these at
# the same model makes the consensus theatre.

# 1. Claude — through the local Claude Code CLI (this machine's subscription,
#    no API key). Set OCR_CLAUDE_RUNTIME=api to use ANTHROPIC_API_KEY instead.
OCR_ANALYST_CLAUDE=true
OCR_CLAUDE_RUNTIME=cli
OCR_CLAUDE_MODEL=claude-opus-5
OCR_CLAUDE_EFFORT=high
OCR_CLAUDE_TIMEOUT_MS=300000

# 2. GPT — reuses the product API's own OPENAI_API_KEY (same account).
OCR_ANALYST_GPT=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OCR_GPT_TIMEOUT_MS=300000
OCR_GPT_MAX_OUTPUT_TOKENS=32000

# 3. GLM — a CHAT model on the same Ollama, NOT glm-ocr. glm-ocr is 0.9B and
#    reads pixels; it cannot weigh a balance chain. Pull one: ollama pull glm4:9b
OCR_ANALYST_GLM=true
GLM_CHAT_MODEL=glm4:9b
OCR_GLM_TIMEOUT_MS=600000
OCR_GLM_NUM_CTX=32768

# ── The vote ────────────────────────────────────────────────────────────────
# Pages handed to a reader at once. Lower it if a model runs out of output
# tokens mid-answer; raise it for short documents.
OCR_PAGES_PER_CHUNK=4
# How many of the three must produce the same value for it to be the answer.
OCR_CONSENSUS_QUORUM=2
# Share of transaction rows that must reach quorum for the extraction to be
# called agreed. Below this it is still delivered, flagged needs_review.
OCR_MIN_TXN_AGREEMENT=0.98
# One retry of a chunk whose readers came back unusable.
OCR_CHUNK_RETRIES=1
