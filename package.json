{
  "name": "dime-ocr",
  "version": "1.0.0",
  "description": "Document extraction agent + API. GLM-OCR (via Ollama) reads the pages; Claude, GPT and GLM independently extract the data and must agree. Claims jobs from the Dime product's boards over an outbound-only connection.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && find src -name '*.js' -exec node --check {} +",
    "agent": "node src/agent/cli.js worker",
    "agent:worker": "node src/agent/cli.js worker",
    "agent:doctor": "node src/agent/cli.js doctor",
    "agent:extract": "node src/agent/cli.js extract",
    "test": "node --test test/"
  },
  "keywords": [
    "ocr",
    "pdf",
    "glm-ocr",
    "ollama",
    "extraction",
    "bank-statement"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "mupdf": "^1.26.4"
  }
}
